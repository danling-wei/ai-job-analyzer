# Copy this file to `.env` and fill in the values you need.
# Anything not set falls back to defaults defined in
# `src/ai_job_analyzer/core/config.py`.

# ---- App ---------------------------------------------------------------
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- API ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list, parsed as JSON by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]

# ---- LLM ---------------------------------------------------------------
# One of: openai | anthropic | ollama | qwen_lora | qwen_service | mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Low-frequency finalizer for skill synonym merging and final narrative.
# `qwen_service` keeps everything local; `openai` uses OPENAI_API_KEY.
FINALIZER_PROVIDER=qwen_service
FINALIZER_MODEL=gpt-5.2
FINALIZER_TEMPERATURE=0

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# Local Qwen LoRA extractor. Install extras with:
#   uv sync --extra qwen-lora
# In-process mode:
# LLM_PROVIDER=qwen_lora
#
# Split-service mode:
#   1. uv run ai-job-analyzer serve-qwen
#   2. set LLM_PROVIDER=qwen_service for the main app
QWEN_BASE_MODEL=Qwen/Qwen3-8B
# QWEN_ADAPTER_PATH=model_lab/models/qwen-job-keyword-lora
QWEN_DEVICE_MAP=auto
QWEN_TORCH_DTYPE=auto
QWEN_MAX_NEW_TOKENS=900
QWEN_SERVICE_HOST=127.0.0.1
QWEN_SERVICE_PORT=8010
QWEN_SERVICE_URL=http://127.0.0.1:8010
QWEN_SERVICE_TIMEOUT_SECONDS=180
QWEN_SERVICE_BATCH_SIZE=1
QWEN_SERVICE_MAX_CONCURRENCY=1

# ---- Scraping ----------------------------------------------------------
SCRAPE_MAX_PER_SOURCE=20
HTTP_TIMEOUT_SECONDS=20
ENABLE_PLAYWRIGHT=true

# API-backed job sources. Leave blank to disable that source.

# SerpApi Google Jobs: https://serpapi.com/google-jobs-api
# SERPAPI_API_KEY=

# ---- Storage -----------------------------------------------------------
CACHE_DIR=.cache
